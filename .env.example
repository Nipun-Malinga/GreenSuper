# Local settings for Taskfile.yml. Copy to .env and adjust: cp .env.example .env
# (.env is git-ignored. DB/PayPal secrets stay in <TOMCAT_HOME>/bin/setenv.sh.)

# Tomcat 10.1+ install folder
TOMCAT_HOME=/path/to/apache-tomcat-10.1.x

# HTTP port from <TOMCAT_HOME>/conf/server.xml
TOMCAT_PORT=8080

# Deploy name: ROOT serves the app at http://localhost:8080/
# any other name serves it at http://localhost:8080/<name>/
APP_CONTEXT=ROOT
