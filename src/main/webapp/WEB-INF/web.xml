<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
         version="5.0">

    <!--
        JSP views live in WEB-INF/views/ (shop, auth, payment, admin, includes), where they
        can't be requested directly. Each page is published at its original URL below, so the
        servlets' redirects, PayPal return URLs and existing links keep working unchanged.

        Adding a page: create it under WEB-INF/views/ and add a servlet + servlet-mapping pair here.
    -->

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Storefront -->
    <servlet>
        <servlet-name>page-index</servlet-name>
        <jsp-file>/WEB-INF/views/shop/index.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>page-index</servlet-name>
        <url-pattern>/index.jsp</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>page-product</servlet-name>
        <jsp-file>/WEB-INF/views/shop/product.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>page-product</servlet-name>
        <url-pattern>/product.jsp</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>page-cart</servlet-name>
        <jsp-file>/WEB-INF/views/shop/cart.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>page-cart</servlet-name>
        <url-pattern>/cart.jsp</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>page-about</servlet-name>
        <jsp-file>/WEB-INF/views/shop/about.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>page-about</servlet-name>
        <url-pattern>/about.jsp</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>page-contact</servlet-name>
        <jsp-file>/WEB-INF/views/shop/contact.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>page-contact</servlet-name>
        <url-pattern>/contact.jsp</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>page-feedback</servlet-name>
        <jsp-file>/WEB-INF/views/shop/feedback.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>page-feedback</servlet-name>
        <url-pattern>/feedback.jsp</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>page-terms-and-conditions</servlet-name>
        <jsp-file>/WEB-INF/views/shop/terms_and_conditions.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>page-terms-and-conditions</servlet-name>
        <url-pattern>/terms_and_conditions.jsp</url-pattern>
    </servlet-mapping>

    <!-- Customer login / registration -->
    <servlet>
        <servlet-name>page-login</servlet-name>
        <jsp-file>/WEB-INF/views/auth/login.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>page-login</servlet-name>
        <url-pattern>/login.jsp</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>page-registration</servlet-name>
        <jsp-file>/WEB-INF/views/auth/registration.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>page-registration</servlet-name>
        <url-pattern>/registration.jsp</url-pattern>
    </servlet-mapping>

    <!-- Payment -->
    <servlet>
        <servlet-name>page-payment-approve</servlet-name>
        <jsp-file>/WEB-INF/views/payment/approve.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>page-payment-approve</servlet-name>
        <url-pattern>/payment_approve.jsp</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>page-payment-success</servlet-name>
        <jsp-file>/WEB-INF/views/payment/success.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>page-payment-success</servlet-name>
        <url-pattern>/payment_success.jsp</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>page-payment-canceled</servlet-name>
        <jsp-file>/WEB-INF/views/payment/canceled.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>page-payment-canceled</servlet-name>
        <url-pattern>/payment_canceled.jsp</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>page-payment-failed</servlet-name>
        <jsp-file>/WEB-INF/views/payment/failed.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>page-payment-failed</servlet-name>
        <url-pattern>/payment_failed.jsp</url-pattern>
    </servlet-mapping>
    <!-- PaymentServlet redirects to "error.jsp" on PayPal errors; there was never such a page, so show the payment-failed page. -->
    <servlet-mapping>
        <servlet-name>page-payment-failed</servlet-name>
        <url-pattern>/error.jsp</url-pattern>
    </servlet-mapping>

    <!-- Admin -->
    <servlet>
        <servlet-name>page-admin-login</servlet-name>
        <jsp-file>/WEB-INF/views/admin/login.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>page-admin-login</servlet-name>
        <url-pattern>/admin_login.jsp</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>page-admin</servlet-name>
        <jsp-file>/WEB-INF/views/admin/dashboard.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>page-admin</servlet-name>
        <url-pattern>/admin.jsp</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>page-admin-categories</servlet-name>
        <jsp-file>/WEB-INF/views/admin/categories.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>page-admin-categories</servlet-name>
        <url-pattern>/admin_categories.jsp</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>page-admin-add-category</servlet-name>
        <jsp-file>/WEB-INF/views/admin/add_category.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>page-admin-add-category</servlet-name>
        <url-pattern>/admin_add_category.jsp</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>page-admin-manage-category</servlet-name>
        <jsp-file>/WEB-INF/views/admin/manage_category.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>page-admin-manage-category</servlet-name>
        <url-pattern>/admin_manage_category.jsp</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>page-admin-products</servlet-name>
        <jsp-file>/WEB-INF/views/admin/products.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>page-admin-products</servlet-name>
        <url-pattern>/admin_products.jsp</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>page-admin-add-product</servlet-name>
        <jsp-file>/WEB-INF/views/admin/add_product.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>page-admin-add-product</servlet-name>
        <url-pattern>/admin_add_product.jsp</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>page-admin-manage-product</servlet-name>
        <jsp-file>/WEB-INF/views/admin/manage_product.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>page-admin-manage-product</servlet-name>
        <url-pattern>/admin_manage_product.jsp</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>page-admin-customers</servlet-name>
        <jsp-file>/WEB-INF/views/admin/customers.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>page-admin-customers</servlet-name>
        <url-pattern>/admin_customers.jsp</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>page-admin-orders</servlet-name>
        <jsp-file>/WEB-INF/views/admin/orders.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>page-admin-orders</servlet-name>
        <url-pattern>/admin_orders.jsp</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>page-admin-failed</servlet-name>
        <jsp-file>/WEB-INF/views/admin/failed.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>page-admin-failed</servlet-name>
        <url-pattern>/admin_failed.jsp</url-pattern>
    </servlet-mapping>
</web-app>
